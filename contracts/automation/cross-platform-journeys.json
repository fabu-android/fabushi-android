      "label": "Runtime 启动",
      "steps": [
        {
          "action": "expectReady",
          "androidOwner": "AndroidCoordinatorRuntime"
        }
      ]
    },
    {
      "id": "chat.send",
      "label": "聊天发送与响应",
      "steps": [
        {
          "action": "sendChat",
          "text": "验证极速自动化测试",
          "expectedReply": "收到：验证极速自动化测试",
          "androidOwner": "AndroidJsonHost + ProductionTurnAgentOwner"
        }
      ]
    },
    {
      "id": "marketplace.install",
      "label": "Marketplace 安装",
      "steps": [
        {
          "action": "installMiniApp",
          "miniAppId": "global-dharma",
          "androidOwner": "MarketplaceViewModel + Host plugin runtime"
        }
      ]
    },
    {
      "id": "miniapp.open",
      "label": "MiniApp 打开",
      "steps": [
        {
          "action": "openMiniApp",
          "miniAppId": "global-dharma",
          "androidOwner": "MiniAppWebMcpSurface"
        }
      ]
    },
    {
      "id": "capability.approval",
      "label": "敏感能力审批",
      "steps": [
        {
          "action": "approveCapability",
          "miniAppId": "global-dharma",
          "capability": "microphone.request",
          "decision": "allow-once",
          "androidOwner": "CapabilityBroker"
        }
      ]
    },
    {
