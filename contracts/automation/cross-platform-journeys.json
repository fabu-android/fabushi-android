      "label": "长任务中断",
      "steps": [
        {
          "action": "interruptOperation",
          "label": "长任务测试",
          "androidOwner": "AndroidCoordinatorRuntime -> AndroidJsonHost"
        }
      ]
    },
    {
      "id": "session.clear",
      "label": "安全会话清除",
      "steps": [
        {
          "action": "clearSession",
          "androidOwner": "typed auth coordinator"
        }
